{
  "version": "0.1.1",
  "scripts": {
    "build": "npm run build:js && npm run build:assets",
    "build:js": "esbuild src/app.ts --bundle --minify --sourcemap --outfile=dist/app.js --format=esm",
    "build:assets": "cp index.html style.css dist/"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
