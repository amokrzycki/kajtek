{
  "version": "0.10",
  "scripts": {
    "dev": "node dev.mjs",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "build": "npm run check && npm run lint && rm -rf dist && npm run build:js && npm run build:css && npm run build:assets && npm run build:hash",
    "build:js": "esbuild src/app.ts --bundle --minify --sourcemap --splitting --outdir=dist --entry-names=app-[hash] --chunk-names=chunk-[hash] --format=esm --loader:.md=text '--define:APP_VERSION=\"'\"$npm_package_version\"'\"'",
    "build:css": "esbuild styles/index.css --bundle --minify --sourcemap --outdir=dist --entry-names=style-[hash]",
    "build:assets": "cp index.html dist/ && rsync -a --exclude='.DS_Store' public/ dist/",
    "build:hash": "node scripts/inject-hashes.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "hls.js": "1.6.16"
  }
}
